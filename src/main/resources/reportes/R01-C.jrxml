                x="310" y="0" width="75" height="36"
                fontName="Arial" fontSize="6"
                hTextAlign="Center"
                vTextAlign="Middle"
                textAdjust="ScaleFont">
                <expression><![CDATA[
                    $F{fechaInicioRol} == null
                    || $F{fechaInicioRol}.trim().isEmpty()
                        ? ""
                        : (
                            $F{fechaInicioRol}.matches("\\d{4}-\\d{2}-\\d{2}.*")
                                ? $F{fechaInicioRol}.substring(8, 10)
                                    + "/"
                                    + $F{fechaInicioRol}.substring(5, 7)
                                    + "/"
                                    + $F{fechaInicioRol}.substring(0, 4)
                                : $F{fechaInicioRol}
                        )
