<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    name="R03"
    language="java"
    columnCount="1"
    pageWidth="2280"
    pageHeight="842"
    orientation="Landscape"
    columnWidth="2240"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    uuid="c3030001-0000-4000-8000-000000000001">

    <!-- ========================================================= -->
    <!-- CONFIGURACIÓN DE EXPORTACIÓN                              -->
    <!-- ========================================================= -->

    <property
        name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows"
        value="true"/>

    <property
        name="net.sf.jasperreports.export.xls.remove.empty.space.between.columns"
        value="true"/>

    <property
        name="net.sf.jasperreports.export.xls.white.page.background"
        value="true"/>

    <property
        name="net.sf.jasperreports.export.xls.ignore.graphics"
        value="false"/>

    <property
        name="net.sf.jasperreports.export.xls.detect.cell.type"
        value="true"/>

    <property
        name="net.sf.jasperreports.export.xlsx.remove.empty.space.between.rows"
        value="true"/>

    <property
        name="net.sf.jasperreports.export.xlsx.remove.empty.space.between.columns"
        value="true"/>

    <property
        name="net.sf.jasperreports.export.xlsx.white.page.background"
        value="true"/>

    <property
        name="net.sf.jasperreports.export.xlsx.ignore.graphics"
        value="false"/>

    <property
        name="net.sf.jasperreports.export.xlsx.detect.cell.type"
        value="true"/>

    <property
        name="net.sf.jasperreports.export.xlsx.one.page.per.sheet"
        value="false"/>

    <property
        name="com.jaspersoft.studio.data.defaultdataadapter"
        value="One Empty Record"/>

    <property name="com.jaspersoft.studio.unit." value="pixel"/>
    <property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>

    <!-- ========================================================= -->
    <!-- PARÁMETROS GENERALES                                     -->
    <!-- ========================================================= -->

    <parameter
        name="tituloReporte"
        class="java.lang.String"/>

    <parameter
        name="codigoReporte"
        class="java.lang.String"/>

    <parameter
        name="versionReporte"
        class="java.lang.String"/>

    <parameter
        name="fechaReporte"
        class="java.lang.String"/>

    <!-- Valores opcionales de cabecera.
         No se dejan quemados en el JRXML. -->
    <parameter
        name="areaGeneraReporte"
        class="java.lang.String"/>

    <parameter
        name="dirigidoA"
        class="java.lang.String"/>

    <!-- ========================================================= -->
    <!-- CAMPOS R03                                                -->
    <!-- ========================================================= -->

    <field
        name="idProyecto"
        class="java.lang.String"/>

    <field
        name="tituloProyecto"
        class="java.lang.String"/>

    <field
        name="estadoProyecto"
        class="java.lang.String"/>

    <field
        name="fechaInicioProyecto"
        class="java.lang.String"/>

    <field
        name="fechaFinProyecto"
        class="java.lang.String"/>

    <field
        name="directorProyecto"
        class="java.lang.String"/>

    <field
        name="gruposInvestigacion"
        class="java.util.List"/>

    <field
        name="facultadesProyecto"
        class="java.lang.String"/>

    <field
        name="departamentoDirector"
        class="java.lang.String"/>

    <field
        name="tipoProyecto"
        class="java.lang.String"/>

    <field
        name="nombreConvocatoria"
        class="java.lang.String"/>

    <field
        name="elementoMisional"
        class="java.lang.String"/>

    <field
        name="palabrasClaves"
        class="java.lang.String"/>

    <background splitType="Stretch"/>

    <!-- ========================================================= -->
    <!-- CABECERA INSTITUCIONAL                                   -->
    <!-- ========================================================= -->

    <pageHeader
        height="104"
        splitType="Stretch">

        <!-- LOGO -->

        <element
            kind="frame"
            uuid="c3030001-0001-4000-8000-000000000001"
            x="0"
            y="0"
            width="260"
            height="60">

            <element
                kind="image"
                uuid="c3030001-0001-4000-8000-000000000002"
                x="95"
                y="2"
                width="70"
                height="56">

                <expression class="java.io.InputStream"><![CDATA[
                    Thread.currentThread()
                        .getContextClassLoader()
                        .getResourceAsStream(
                            "reportes/Escudo-Unicauca.png"
                        )
                ]]></expression>

            </element>

            <box>
                <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                <topPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
            </box>

        </element>

        <!-- UNIVERSIDAD -->

        <element
            kind="staticText"
            uuid="c3030001-0002-4000-8000-000000000001"
            x="260"
            y="0"
            width="1980"
            height="26"
            fontName="Arial"
            fontSize="11"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle">

            <text><![CDATA[Universidad del Cauca]]></text>

            <box>
                <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                <topPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
            </box>

        </element>

        <!-- TÍTULO -->

        <element
            kind="textField"
            uuid="c3030001-0003-4000-8000-000000000001"
            x="260"
            y="26"
            width="1980"
            height="34"
            fontName="Arial"
            fontSize="13"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle"
            textAdjust="ScaleFont">

            <expression><![CDATA[
                $P{tituloReporte}
            ]]></expression>

            <box>
                <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                <topPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
            </box>

        </element>

        <!-- CÓDIGO -->

        <element
            kind="textField"
            uuid="c3030001-0004-4000-8000-000000000001"
            x="0"
            y="60"
            width="740"
            height="22"
            fontName="Arial"
            fontSize="9"
            hTextAlign="Center"
            vTextAlign="Middle">

            <expression><![CDATA[
                "Código: "
                + ($P{codigoReporte} == null
                    ? ""
                    : $P{codigoReporte})
            ]]></expression>

            <box>
                <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                <topPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
            </box>

        </element>

        <!-- VERSIÓN -->

        <element
            kind="textField"
            uuid="c3030001-0005-4000-8000-000000000001"
            x="740"
            y="60"
            width="750"
            height="22"
            fontName="Arial"
            fontSize="9"
            hTextAlign="Center"
            vTextAlign="Middle">

            <expression><![CDATA[
                "Versión: "
                + ($P{versionReporte} == null
                    ? ""
                    : $P{versionReporte})
            ]]></expression>

            <box>
                <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                <topPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
            </box>

        </element>

        <!-- FECHA -->

        <element
            kind="textField"
            uuid="c3030001-0006-4000-8000-000000000001"
            x="1490"
            y="60"
            width="750"
            height="22"
            fontName="Arial"
            fontSize="9"
            hTextAlign="Center"
            vTextAlign="Middle">

            <expression><![CDATA[
                "Fecha Reporte: "
                + ($P{fechaReporte} == null
                    ? ""
                    : $P{fechaReporte})
            ]]></expression>

            <box>
                <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                <topPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
            </box>

        </element>

        <!-- ===================================================== -->
        <!-- ÁREA / DIRIGIDO A - UNA SOLA FILA 50 / 50           -->
        <!-- Los valores no se dejan quemados en el JRXML         -->
        <!-- ===================================================== -->

        <element
            kind="textField"
            uuid="c3030001-0007-4000-8000-000000000001"
            x="0"
            y="82"
            width="1120"
            height="22"
            fontName="Arial"
            fontSize="9"
            bold="true"
            vTextAlign="Middle">

            <expression><![CDATA[
                "Área que genera el reporte:"
                + (
                    $P{areaGeneraReporte} == null
                    || $P{areaGeneraReporte}.trim().isEmpty()
                        ? ""
                        : " " + $P{areaGeneraReporte}
                )
            ]]></expression>

            <box>
                <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                <topPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
            </box>

        </element>

        <element
            kind="textField"
            uuid="c3030001-0008-4000-8000-000000000001"
            x="1120"
            y="82"
            width="1120"
            height="22"
            fontName="Arial"
            fontSize="9"
            bold="true"
            vTextAlign="Middle">

            <expression><![CDATA[
                "Dirigido a:"
                + (
                    $P{dirigidoA} == null
                    || $P{dirigidoA}.trim().isEmpty()
                        ? ""
                        : " " + $P{dirigidoA}
                )
            ]]></expression>

            <box>
                <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                <topPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
            </box>

        </element>

    </pageHeader>

    <!-- ========================================================= -->
    <!-- CABECERA DE COLUMNAS                                     -->
    <!-- ========================================================= -->

    <columnHeader
        height="52"
        splitType="Stretch">

        <!-- 1 ID PROYECTO -->
        <element kind="staticText"
            uuid="c3030001-0101-4000-8000-000000000001"
            x="0" y="0"
            width="90" height="52"
            fontName="Arial"
            fontSize="7"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle">
            <text><![CDATA[ID proyecto]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 2 TÍTULO -->
        <element kind="staticText"
            uuid="c3030001-0102-4000-8000-000000000001"
            x="90" y="0"
            width="260" height="52"
            fontName="Arial"
            fontSize="7"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle">
            <text><![CDATA[Título proyecto]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 3 ESTADO -->
        <element kind="staticText"
            uuid="c3030001-0103-4000-8000-000000000001"
            x="350" y="0"
            width="120" height="52"
            fontName="Arial"
            fontSize="7"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle">
            <text><![CDATA[Estado proyecto]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 4 FECHA INICIO -->
        <element kind="staticText"
            uuid="c3030001-0104-4000-8000-000000000001"
            x="470" y="0"
            width="110" height="52"
            fontName="Arial"
            fontSize="7"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle">
            <text><![CDATA[Fecha de inicio]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 5 FECHA FIN -->
        <element kind="staticText"
            uuid="c3030001-0105-4000-8000-000000000001"
            x="580" y="0"
            width="110" height="52"
            fontName="Arial"
            fontSize="7"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle">
            <text><![CDATA[Fecha de finalización]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 6 DIRECTOR -->
        <element kind="staticText"
            uuid="c3030001-0106-4000-8000-000000000001"
            x="690" y="0"
            width="170" height="52"
            fontName="Arial"
            fontSize="7"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle">
            <text><![CDATA[Director proyecto]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 7 GRUPOS -->
        <element kind="staticText"
            uuid="c3030001-0107-4000-8000-000000000001"
            x="860" y="0"
            width="250" height="52"
            fontName="Arial"
            fontSize="7"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle">
            <text><![CDATA[Grupo(s) de investigación]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 8 FACULTADES -->
        <element kind="staticText"
            uuid="c3030001-0108-4000-8000-000000000001"
            x="1110" y="0"
            width="220" height="52"
            fontName="Arial"
            fontSize="7"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle">
            <text><![CDATA[Facultad(es)]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 9 DEPARTAMENTO -->
        <element kind="staticText"
            uuid="c3030001-0109-4000-8000-000000000001"
            x="1330" y="0"
            width="160" height="52"
            fontName="Arial"
            fontSize="7"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle">
            <text><![CDATA[Departamento(s)]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 10 TIPO PROYECTO -->
        <element kind="staticText"
            uuid="c3030001-0110-4000-8000-000000000001"
            x="1490" y="0"
            width="100" height="52"
            fontName="Arial"
            fontSize="7"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle">
            <text><![CDATA[Tipo proyecto]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 11 CONVOCATORIA -->
        <element kind="staticText"
            uuid="c3030001-0111-4000-8000-000000000001"
            x="1590" y="0"
            width="220" height="52"
            fontName="Arial"
            fontSize="7"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle">
            <text><![CDATA[Nombre Convocatoria]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 12 ELEMENTO MISIONAL -->
        <element kind="staticText"
            uuid="c3030001-0112-4000-8000-000000000001"
            x="1810" y="0"
            width="200" height="52"
            fontName="Arial"
            fontSize="7"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle">
            <text><![CDATA[División VRI / Elemento misional]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 13 PALABRAS CLAVE -->
        <element kind="staticText"
            uuid="c3030001-0113-4000-8000-000000000001"
            x="2010" y="0"
            width="230" height="52"
            fontName="Arial"
            fontSize="7"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle">
            <text><![CDATA[Palabras claves]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

    </columnHeader>

    <!-- ========================================================= -->
    <!-- DETALLE                                                  -->
    <!-- ========================================================= -->

    <detail>

        <band
            height="42"
            splitType="Stretch">

            <!-- 1 ID -->

            <element kind="textField"
                uuid="c3030001-0201-4000-8000-000000000001"
                x="0" y="0"
                width="90" height="42"
                fontName="Arial"
                fontSize="8"
                hTextAlign="Center"
                vTextAlign="Middle"
                textAdjust="ScaleFont">

                <expression><![CDATA[
                    $F{idProyecto}
                ]]></expression>

                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>

            </element>

            <!-- 2 TÍTULO -->

            <element kind="textField"
                uuid="c3030001-0202-4000-8000-000000000001"
                x="90" y="0"
                width="260" height="42"
                fontName="Arial"
                fontSize="8"
                vTextAlign="Middle"
                textAdjust="ScaleFont">

                <expression><![CDATA[
                    $F{tituloProyecto}
                ]]></expression>

                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>

            </element>

            <!-- 3 ESTADO -->

            <element kind="textField"
                uuid="c3030001-0203-4000-8000-000000000001"
                x="350" y="0"
                width="120" height="42"
                fontName="Arial"
                fontSize="8"
                hTextAlign="Center"
                vTextAlign="Middle"
                textAdjust="ScaleFont">

                <expression><![CDATA[
                    $F{estadoProyecto}
                ]]></expression>

                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>

            </element>

            <!-- 4 FECHA INICIO -->

            <element kind="textField"
                uuid="c3030001-0204-4000-8000-000000000001"
                x="470" y="0"
                width="110" height="42"
                fontName="Arial"
                fontSize="8"
                hTextAlign="Center"
                vTextAlign="Middle"
                textAdjust="ScaleFont">

                <expression><![CDATA[
                    $F{fechaInicioProyecto}
                ]]></expression>

                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>

            </element>

            <!-- 5 FECHA FIN -->

            <element kind="textField"
                uuid="c3030001-0205-4000-8000-000000000001"
                x="580" y="0"
                width="110" height="42"
                fontName="Arial"
                fontSize="8"
                hTextAlign="Center"
                vTextAlign="Middle"
                textAdjust="ScaleFont">

                <expression><![CDATA[
                    $F{fechaFinProyecto}
                ]]></expression>

                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>

            </element>

            <!-- 6 DIRECTOR -->

            <element kind="textField"
                uuid="c3030001-0206-4000-8000-000000000001"
                x="690" y="0"
                width="170" height="42"
                fontName="Arial"
                fontSize="8"
                vTextAlign="Middle"
                textAdjust="ScaleFont">

                <expression><![CDATA[
                    $F{directorProyecto}
                ]]></expression>

                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>

            </element>

            <!-- 7 GRUPOS INVESTIGACIÓN -->

            <element kind="textField"
                uuid="c3030001-0207-4000-8000-000000000001"
                x="860" y="0"
                width="250" height="42"
                fontName="Arial"
                fontSize="7"
                vTextAlign="Middle"
                textAdjust="ScaleFont">

                <expression><![CDATA[
                    $F{gruposInvestigacion} == null
                        ? ""
                        : java.lang.String.join(
                            ", ",
                            (java.util.List<String>)
                                $F{gruposInvestigacion}
                        )
                ]]></expression>

                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>

            </element>

            <!-- 8 FACULTADES -->

            <element kind="textField"
                uuid="c3030001-0208-4000-8000-000000000001"
                x="1110" y="0"
                width="220" height="42"
                fontName="Arial"
                fontSize="7"
                vTextAlign="Middle"
                textAdjust="ScaleFont">

                <expression><![CDATA[
                    $F{facultadesProyecto}
                ]]></expression>

                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>

            </element>

            <!-- 9 DEPARTAMENTO -->

            <element kind="textField"
                uuid="c3030001-0209-4000-8000-000000000001"
                x="1330" y="0"
                width="160" height="42"
                fontName="Arial"
                fontSize="7"
                vTextAlign="Middle"
                textAdjust="ScaleFont">

                <expression><![CDATA[
                    $F{departamentoDirector}
                ]]></expression>

                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>

            </element>

            <!-- 10 TIPO -->

            <element kind="textField"
                uuid="c3030001-0210-4000-8000-000000000001"
                x="1490" y="0"
                width="100" height="42"
                fontName="Arial"
                fontSize="8"
                hTextAlign="Center"
                vTextAlign="Middle"
                textAdjust="ScaleFont">

                <expression><![CDATA[
                    $F{tipoProyecto}
                ]]></expression>

                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>

            </element>

            <!-- 11 CONVOCATORIA -->

            <element kind="textField"
                uuid="c3030001-0211-4000-8000-000000000001"
                x="1590" y="0"
                width="220" height="42"
                fontName="Arial"
                fontSize="7"
                vTextAlign="Middle"
                textAdjust="ScaleFont">

                <expression><![CDATA[
                    $F{nombreConvocatoria}
                ]]></expression>

                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>

            </element>

            <!-- 12 ELEMENTO MISIONAL -->

            <element kind="textField"
                uuid="c3030001-0212-4000-8000-000000000001"
                x="1810" y="0"
                width="200" height="42"
                fontName="Arial"
                fontSize="7"
                vTextAlign="Middle"
                textAdjust="ScaleFont">

                <expression><![CDATA[
                    $F{elementoMisional}
                ]]></expression>

                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>

            </element>

            <!-- 13 PALABRAS CLAVE -->

            <element kind="textField"
                uuid="c3030001-0213-4000-8000-000000000001"
                x="2010" y="0"
                width="230" height="42"
                fontName="Arial"
                fontSize="7"
                vTextAlign="Middle"
                textAdjust="ScaleFont">

                <expression><![CDATA[
                    $F{palabrasClaves}
                ]]></expression>

                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
