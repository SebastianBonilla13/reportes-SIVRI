    orientation="Landscape"
    columnWidth="2600"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    uuid="b6010001-0000-4000-8000-000000000001">

    <!-- ========================================================= -->
    <!-- CONFIGURACIÓN EXCEL                                      -->
    <!-- ========================================================= -->

    <property
        name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows"
        value="true"/>

    <property
