                        width="120">

                        <columnHeader height="22" style="TableHeader">
                            <element kind="staticText"
                                x="0" y="0"
                                width="120" height="22"
                                fontName="Arial"
                                fontSize="7"
                                bold="true"
                                hTextAlign="Center"
                                vTextAlign="Middle">
                                <text><![CDATA[Fecha creación]]></text>
                            </element>
                        </columnHeader>

                        <detailCell height="22" style="TableCell">
                            <element kind="textField"
                                x="0" y="0"
                                width="120" height="22"
                                fontName="Arial"
                                fontSize="7"
                                hTextAlign="Center"
                                vTextAlign="Middle">
                                <expression><![CDATA[
                                    $F{fechaCreacionSemillero} == null
                                    || $F{fechaCreacionSemillero}.trim().isEmpty()
                                        ? ""
                                        : (
                                            $F{fechaCreacionSemillero}
                                                .matches("\\d{4}-\\d{2}-\\d{2}.*")
                                                ? $F{fechaCreacionSemillero}.substring(8, 10)
                                                    + "/"
                                                    + $F{fechaCreacionSemillero}.substring(5, 7)
                                                    + "/"
                                                    + $F{fechaCreacionSemillero}.substring(0, 4)
                                                : $F{fechaCreacionSemillero}
                                        )
                                ]]></expression>
                            </element>
                        </detailCell>

                    </column>

