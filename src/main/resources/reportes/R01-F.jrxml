<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    name="R01_F"
    language="java"
    pageWidth="595"
    pageHeight="842"
    columnWidth="555"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    whenNoDataType="AllSectionsNoDetail"
    uuid="f0100001-0000-4000-8000-000000000001">

    <!-- ========================================================= -->
    <!-- ESTILOS                                                   -->
    <!-- ========================================================= -->

    <style
        name="TableHeader"
        mode="Opaque"
        backcolor="#D9D9D9"
        fontName="Arial"
        fontSize="7"
        bold="true">

        <box>
            <pen
                lineWidth="0.5"
                lineColor="#A6A6A6"/>
        </box>

    </style>

    <style
        name="TableCell"
        fontName="Arial"
        fontSize="7">

        <box>
            <pen
                lineWidth="0.5"
                lineColor="#CCCCCC"/>
        </box>

    </style>

    <!-- ========================================================= -->
    <!-- DATASET INTEGRANTES                                       -->
    <!-- ========================================================= -->

    <dataset
        name="IntegrantesDataset"
        uuid="f0100002-0000-4000-8000-000000000001">

        <field
            name="numeroIdentificacion"
            class="java.lang.String"/>

        <field
            name="nombreIntegrante"
            class="java.lang.String"/>

        <field
            name="historialRolesEnGrupo"
            class="java.lang.String"/>

        <field
            name="estadoIntegranteGrupo"
            class="java.lang.String"/>

    </dataset>

    <!-- ========================================================= -->
    <!-- DATASET PROYECTOS                                         -->
    <!-- ========================================================= -->

    <dataset
        name="ProyectosDataset"
        uuid="f0100003-0000-4000-8000-000000000001">

        <field
            name="idProyecto"
            class="java.lang.String"/>

        <field
            name="tipoProyecto"
            class="java.lang.String"/>

        <field
            name="nombreConvocatoria"
            class="java.lang.String"/>

    </dataset>

    <!-- ========================================================= -->
    <!-- DATASET SEMILLEROS                                        -->
    <!-- ========================================================= -->

    <dataset
        name="SemillerosDataset"
        uuid="f0100004-0000-4000-8000-000000000001">

        <field
            name="idSemillero"
            class="java.lang.String"/>

        <field
            name="nombreSemillero"
            class="java.lang.String"/>

        <field
            name="fechaCreacionSemillero"
            class="java.lang.String"/>

        <field
            name="estadoSemillero"
            class="java.lang.String"/>

    </dataset>

    <!-- ========================================================= -->
    <!-- DATASET PRODUCTOS ENTREGADOS                              -->
    <!-- ========================================================= -->

    <dataset
        name="ProductosEntregadosDataset"
        uuid="f0100005-0000-4000-8000-000000000001">

        <field
            name="representanteProductoEntregado"
            class="java.lang.String"/>

        <field
            name="tipoProductoEntregado"
            class="java.lang.String"/>

        <field
            name="nombreResponsableProductoEntregado"
            class="java.lang.String"/>

    </dataset>

    <!-- ========================================================= -->
    <!-- DATASET PRODUCTOS PENDIENTES                              -->
    <!-- ========================================================= -->

    <dataset
        name="ProductosPendientesDataset"
        uuid="f0100006-0000-4000-8000-000000000001">

        <field
            name="representanteProductoPendiente"
            class="java.lang.String"/>

        <field
            name="tipoProductoPendiente"
            class="java.lang.String"/>

        <field
            name="nombreResponsableProductoPendiente"
            class="java.lang.String"/>

    </dataset>

    <!-- ========================================================= -->
    <!-- PARÁMETROS GENERALES                                     -->
    <!-- ========================================================= -->

    <parameter
        name="tituloReporte"
        class="java.lang.String"/>

    <parameter
        name="codigoReporte"
        class="java.lang.String"/>

    <parameter
        name="versionReporte"
        class="java.lang.String"/>

    <parameter
        name="fechaReporte"
        class="java.lang.String"/>

    <!-- ========================================================= -->
    <!-- DATOS DEL GRUPO                                          -->
    <!-- ========================================================= -->

    <parameter
        name="idGrupo"
        class="java.lang.String"/>

    <parameter
        name="nombreGrupo"
        class="java.lang.String"/>

    <parameter
        name="codigoGruplac"
        class="java.lang.String"/>

    <parameter
        name="categorizacionGrupo"
        class="java.lang.String"/>

    <parameter
        name="facultadGrupo"
        class="java.lang.String"/>

    <!-- ========================================================= -->
    <!-- LISTAS                                                    -->
    <!-- ========================================================= -->

    <parameter
        name="LISTA_INTEGRANTES"
        class="java.util.List"/>

    <parameter
        name="LISTA_PROYECTOS"
        class="java.util.List"/>

    <parameter
        name="LISTA_SEMILLEROS"
        class="java.util.List"/>

    <parameter
        name="LISTA_PRODUCTOS_ENTREGADOS"
        class="java.util.List"/>

    <parameter
        name="LISTA_PRODUCTOS_PENDIENTES"
        class="java.util.List"/>


    <!-- ========================================================= -->
    <!-- CAMPOS RAÍZ PARA LAS LISTAS ANIDADAS                     -->
    <!-- Se leen directamente desde el objeto recibido del front   -->
    <!-- ========================================================= -->

    <field name="integrantes" class="java.util.List"/>
    <field name="proyectos" class="java.util.List"/>
    <field name="semilleros" class="java.util.List"/>
    <field name="productosEntregados" class="java.util.List"/>
    <field name="productosPendientes" class="java.util.List"/>

    <background splitType="Stretch"/>

