        <!-- INFORMACIÓN GENERAL DEL GRUPO                        -->
        <!-- Se ubica después de la cabecera institucional        -->
        <!-- ===================================================== -->

        


        <!-- ===================================================== -->
        <!-- 1. INTEGRANTES                                       -->
        <!-- ===================================================== -->

        <band
            height="64"
            splitType="Stretch">

            <element
                kind="staticText"
                uuid="f0100100-0000-4000-8000-000000000001"
                x="0"
                y="4"
                width="555"
                height="20"
                mode="Opaque"
                backcolor="#D9D9D9"
                fontName="Arial"
                fontSize="8"
                bold="true"
                vTextAlign="Middle">

                <text><![CDATA[
                    Integrantes por Grupo
                ]]></text>

                <box>
                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>
                </box>

            </element>

            <element
                kind="component"
                uuid="f0100101-0000-4000-8000-000000000001"
                x="0"
                y="24"
                width="555"
                height="40">

                <component kind="table">

                    <datasetRun
                        uuid="f0100102-0000-4000-8000-000000000001"
                        subDataset="IntegrantesDataset">

                        <dataSourceExpression><![CDATA[
                            new net.sf.jasperreports.engine.data
                                .JRBeanCollectionDataSource(
                                    $F{integrantes}
                                )
                        ]]></dataSourceExpression>

                    </datasetRun>

                    <!-- IDENTIFICACIÓN -->

                    <column
                        kind="single"
                        uuid="f0100103-0000-4000-8000-000000000001"
                        width="100">

                        <columnHeader
                            height="22"
                            style="TableHeader">

                            <element
                                kind="staticText"
                                x="0"
                                y="0"
                                width="100"
                                height="22"
                                fontName="Arial"
                                fontSize="7"
                                bold="true"
                                hTextAlign="Center"
                                vTextAlign="Middle">

                                <text><![CDATA[Identificación]]></text>

                            </element>

                        </columnHeader>

                        <detailCell
                            height="22"
                            style="TableCell">

                            <element
                                kind="textField"
                                x="0"
                                y="0"
                                width="100"
                                height="22"
                                fontName="Arial"
                                fontSize="7"
                                hTextAlign="Center"
                                vTextAlign="Middle"
                                textAdjust="StretchHeight">

                                <expression><![CDATA[
                                    $F{numeroIdentificacion}
                                ]]></expression>

                            </element>

                        </detailCell>

                    </column>

                    <!-- NOMBRE -->

                    <column
                        kind="single"
                        uuid="f0100104-0000-4000-8000-000000000001"
                        width="220">

                        <columnHeader height="22" style="TableHeader">

                            <element
                                kind="staticText"
                                x="0"
                                y="0"
                                width="220"
                                height="22"
                                fontName="Arial"
                                fontSize="7"
                                bold="true"
                                hTextAlign="Center"
                                vTextAlign="Middle">

                                <text><![CDATA[Nombre integrante]]></text>

                            </element>

                        </columnHeader>

                        <detailCell height="22" style="TableCell">

                            <element
                                kind="textField"
                                x="0"
                                y="0"
                                width="220"
                                height="22"
                                fontName="Arial"
                                fontSize="7"
                                vTextAlign="Middle"
                                textAdjust="StretchHeight"
                                hTextAlign="Left">

                                <expression><![CDATA[
                                    $F{nombreIntegrante}
                                ]]></expression>

                            </element>

                        </detailCell>

                    </column>

                    <!-- ROL -->

                    <column
                        kind="single"
                        uuid="f0100105-0000-4000-8000-000000000001"
                        width="135">

                        <columnHeader height="22" style="TableHeader">

                            <element
                                kind="staticText"
                                x="0"
                                y="0"
