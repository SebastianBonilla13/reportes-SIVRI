<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    name="S04"
    language="java"
    columnCount="1"
    pageWidth="1960"
    pageHeight="842"
    orientation="Landscape"
    columnWidth="1920"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    uuid="f6040001-0000-4000-8000-000000000001">

    <!-- ========================================================= -->
    <!-- CONFIGURACIÓN EXCEL                                      -->
    <!-- ========================================================= -->

    <property
        name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows"
        value="true"/>

    <property
        name="net.sf.jasperreports.export.xls.remove.empty.space.between.columns"
        value="true"/>

    <property
        name="net.sf.jasperreports.export.xls.white.page.background"
        value="true"/>

    <property
        name="net.sf.jasperreports.export.xls.ignore.graphics"
        value="false"/>

    <property
        name="net.sf.jasperreports.export.xls.detect.cell.type"
        value="true"/>

    <property
        name="net.sf.jasperreports.export.xlsx.remove.empty.space.between.rows"
        value="true"/>

    <property
        name="net.sf.jasperreports.export.xlsx.remove.empty.space.between.columns"
        value="true"/>

    <property
        name="net.sf.jasperreports.export.xlsx.white.page.background"
        value="true"/>

    <property
        name="net.sf.jasperreports.export.xlsx.ignore.graphics"
        value="false"/>

    <property
        name="net.sf.jasperreports.export.xlsx.detect.cell.type"
        value="true"/>

    <property
        name="net.sf.jasperreports.export.xlsx.one.page.per.sheet"
        value="false"/>

    <property
        name="com.jaspersoft.studio.data.defaultdataadapter"
        value="One Empty Record"/>

    <property name="com.jaspersoft.studio.unit." value="pixel"/>
    <property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>

    <!-- ========================================================= -->
    <!-- PARÁMETROS                                               -->
    <!-- ========================================================= -->

    <parameter name="tituloReporte" class="java.lang.String"/>
    <parameter name="codigoReporte" class="java.lang.String"/>
    <parameter name="versionReporte" class="java.lang.String"/>
    <parameter name="fechaReporte" class="java.lang.String"/>

    <!-- Valores opcionales de cabecera.
         No se dejan quemados en el JRXML. -->
    <parameter name="areaGeneraReporte" class="java.lang.String"/>
    <parameter name="dirigidoA" class="java.lang.String"/>

    <!-- ========================================================= -->
    <!-- CAMPOS S04                                               -->
    <!-- ========================================================= -->

    <field name="idPlanTrabajo" class="java.lang.String"/>

    <field name="estadoSemillero" class="java.lang.String"/>

    <field name="nombreActividadPlanTrabajo" class="java.lang.String"/>
    <field name="objetivoActividadPlanTrabajo" class="java.lang.String"/>

    <field name="fechaInicioActividadPlanTrabajo" class="java.lang.String"/>
    <field name="fechaFinActividadPlanTrabajo" class="java.lang.String"/>

    <field name="estadoProducto" class="java.lang.String"/>

    <field name="tipologiaProducto" class="java.lang.String"/>
    <field name="categoriaProducto" class="java.lang.String"/>

    <field name="nombreResponsableProducto" class="java.lang.String"/>
    <field name="nombreGrupoResponsableProducto" class="java.lang.String"/>

    <background splitType="Stretch"/>

    <!-- ========================================================= -->
    <!-- CABECERA INSTITUCIONAL                                   -->
    <!-- ========================================================= -->

    <pageHeader
        height="104"
        splitType="Stretch">

        <!-- LOGO -->

        <element
            kind="frame"
            uuid="f6040001-0001-4000-8000-000000000001"
            x="0"
            y="0"
            width="260"
            height="60">

            <element
                kind="image"
                uuid="f6040001-0001-4000-8000-000000000002"
                x="95"
                y="2"
                width="70"
                height="56">

                <expression class="java.io.InputStream"><![CDATA[
                    Thread.currentThread()
                        .getContextClassLoader()
                        .getResourceAsStream(
                            "reportes/Escudo-Unicauca.png"
                        )
                ]]></expression>

            </element>

            <box>
                <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                <topPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
            </box>

        </element>

        <!-- UNIVERSIDAD -->

        <element
            kind="staticText"
            uuid="f6040001-0002-4000-8000-000000000001"
            x="260"
            y="0"
            width="1660"
            height="26"
            fontName="Arial"
            fontSize="11"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle">

            <text><![CDATA[Universidad del Cauca]]></text>

            <box>
                <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                <topPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
            </box>

        </element>

        <!-- TÍTULO -->

        <element
            kind="textField"
            uuid="f6040001-0003-4000-8000-000000000001"
            x="260"
            y="26"
            width="1660"
            height="34"
            fontName="Arial"
            fontSize="13"
            bold="true"
            hTextAlign="Center"
            vTextAlign="Middle"
            textAdjust="ScaleFont">

            <expression><![CDATA[
                $P{tituloReporte}
            ]]></expression>

            <box>
                <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                <topPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
            </box>

        </element>

        <!-- CÓDIGO -->

        <element
            kind="textField"
            uuid="f6040001-0004-4000-8000-000000000001"
            x="0"
            y="60"
            width="640"
            height="22"
            fontName="Arial"
            fontSize="9"
            hTextAlign="Center"
            vTextAlign="Middle">

            <expression><![CDATA[
                "Código: "
                + ($P{codigoReporte} == null
                    ? ""
                    : $P{codigoReporte})
            ]]></expression>

            <box>
                <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                <topPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
            </box>

        </element>

        <!-- VERSIÓN -->

        <element
            kind="textField"
            uuid="f6040001-0005-4000-8000-000000000001"
            x="640"
            y="60"
            width="640"
            height="22"
            fontName="Arial"
            fontSize="9"
            hTextAlign="Center"
            vTextAlign="Middle">

            <expression><![CDATA[
                "Versión: "
                + ($P{versionReporte} == null
                    ? ""
                    : $P{versionReporte})
            ]]></expression>

            <box>
                <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                <topPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
            </box>

        </element>

        <!-- FECHA -->

        <element
            kind="textField"
            uuid="f6040001-0006-4000-8000-000000000001"
            x="1280"
            y="60"
            width="640"
            height="22"
            fontName="Arial"
            fontSize="9"
            hTextAlign="Center"
            vTextAlign="Middle">

            <expression><![CDATA[
                "Fecha Reporte: "
                + ($P{fechaReporte} == null
                    ? ""
                    : $P{fechaReporte})
            ]]></expression>

            <box>
                <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                <topPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
            </box>

        </element>

        <!-- ===================================================== -->
        <!-- ÁREA / DIRIGIDO A - UNA SOLA FILA 50 / 50           -->
        <!-- Los valores no se dejan quemados en el JRXML         -->
        <!-- ===================================================== -->

        <element
            kind="textField"
            uuid="f6040001-0007-4000-8000-000000000001"
            x="0"
            y="82"
            width="960"
            height="22"
            fontName="Arial"
            fontSize="9"
            bold="true"
            vTextAlign="Middle">

            <expression><![CDATA[
                "Área que genera el reporte:"
                + (
                    $P{areaGeneraReporte} == null
                    || $P{areaGeneraReporte}.trim().isEmpty()
                        ? ""
                        : " " + $P{areaGeneraReporte}
                )
            ]]></expression>

            <box>
                <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                <topPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
            </box>

        </element>

        <element
            kind="textField"
            uuid="f6040001-0008-4000-8000-000000000001"
            x="960"
            y="82"
            width="960"
            height="22"
            fontName="Arial"
            fontSize="9"
            bold="true"
            vTextAlign="Middle">

            <expression><![CDATA[
                "Dirigido a:"
                + (
                    $P{dirigidoA} == null
                    || $P{dirigidoA}.trim().isEmpty()
                        ? ""
                        : " " + $P{dirigidoA}
                )
            ]]></expression>

            <box>
                <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                <topPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
                <rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
            </box>

        </element>

    </pageHeader>

    <!-- ========================================================= -->
    <!-- CABECERAS DE COLUMNAS                                    -->
    <!-- TOTAL = 1920                                             -->
    <!-- ========================================================= -->

    <columnHeader
        height="58"
        splitType="Stretch">

        <!-- 1 -->

        <element kind="staticText"
            uuid="f6040001-0101-4000-8000-000000000001"
            x="0" y="0"
            width="150" height="58"
            fontName="Arial" fontSize="7" bold="true"
            hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[ID Plan de trabajo]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 2 -->

        <element kind="staticText"
            uuid="f6040001-0102-4000-8000-000000000001"
            x="150" y="0"
            width="100" height="58"
            fontName="Arial" fontSize="7" bold="true"
            hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[Estado Semillero]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 3 -->

        <element kind="staticText"
            uuid="f6040001-0103-4000-8000-000000000001"
            x="250" y="0"
            width="220" height="58"
            fontName="Arial" fontSize="7" bold="true"
            hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[Actividad]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 4 -->

        <element kind="staticText"
            uuid="f6040001-0104-4000-8000-000000000001"
            x="470" y="0"
            width="260" height="58"
            fontName="Arial" fontSize="7" bold="true"
            hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[Objetivo]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 5 -->

        <element kind="staticText"
            uuid="f6040001-0105-4000-8000-000000000001"
            x="730" y="0"
            width="120" height="58"
            fontName="Arial" fontSize="7" bold="true"
            hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[Fecha inicio actividad]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 6 -->

        <element kind="staticText"
            uuid="f6040001-0106-4000-8000-000000000001"
            x="850" y="0"
            width="120" height="58"
            fontName="Arial" fontSize="7" bold="true"
            hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[Fecha finalización actividad]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 7 -->

        <element kind="staticText"
            uuid="f6040001-0107-4000-8000-000000000001"
            x="970" y="0"
            width="120" height="58"
            fontName="Arial" fontSize="7" bold="true"
            hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[Estado producto]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 8 -->

        <element kind="staticText"
            uuid="f6040001-0108-4000-8000-000000000001"
            x="1090" y="0"
            width="190" height="58"
            fontName="Arial" fontSize="7" bold="true"
            hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[Tipología de producto]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 9 -->

        <element kind="staticText"
            uuid="f6040001-0109-4000-8000-000000000001"
            x="1280" y="0"
            width="200" height="58"
            fontName="Arial" fontSize="7" bold="true"
            hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[Categoría producto]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 10 -->

        <element kind="staticText"
            uuid="f6040001-0110-4000-8000-000000000001"
            x="1480" y="0"
            width="180" height="58"
            fontName="Arial" fontSize="7" bold="true"
            hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[Nombre Responsable producto]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

        <!-- 11 -->

        <element kind="staticText"
            uuid="f6040001-0111-4000-8000-000000000001"
            x="1660" y="0"
            width="260" height="58"
            fontName="Arial" fontSize="7" bold="true"
            hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[Grupo de investigación del responsable]]></text>
            <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
        </element>

    </columnHeader>

    <!-- ========================================================= -->
    <!-- DETALLE                                                  -->
    <!-- ========================================================= -->

    <detail>

        <band
            height="42"
            splitType="Stretch">

            <element kind="textField"
                uuid="f6040001-0201-4000-8000-000000000001"
                x="0" y="0"
                width="150" height="42"
                fontName="Arial" fontSize="8"
                hTextAlign="Center"
                vTextAlign="Middle"
                textAdjust="ScaleFont">
                <expression><![CDATA[$F{idPlanTrabajo}]]></expression>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
            </element>

            <element kind="textField"
                uuid="f6040001-0202-4000-8000-000000000001"
                x="150" y="0"
                width="100" height="42"
                fontName="Arial" fontSize="8"
                hTextAlign="Center"
                vTextAlign="Middle"
                textAdjust="ScaleFont">
                <expression><![CDATA[$F{estadoSemillero}]]></expression>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
            </element>

            <element kind="textField"
                uuid="f6040001-0203-4000-8000-000000000001"
                x="250" y="0"
                width="220" height="42"
                fontName="Arial" fontSize="8"
                vTextAlign="Middle"
                textAdjust="ScaleFont">
                <expression><![CDATA[$F{nombreActividadPlanTrabajo}]]></expression>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
            </element>

            <element kind="textField"
                uuid="f6040001-0204-4000-8000-000000000001"
                x="470" y="0"
                width="260" height="42"
                fontName="Arial" fontSize="8"
                vTextAlign="Middle"
                textAdjust="ScaleFont">
                <expression><![CDATA[$F{objetivoActividadPlanTrabajo}]]></expression>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
            </element>

            <element kind="textField"
                uuid="f6040001-0205-4000-8000-000000000001"
                x="730" y="0"
                width="120" height="42"
                fontName="Arial" fontSize="7"
                hTextAlign="Center"
                vTextAlign="Middle"
                textAdjust="ScaleFont">
                <expression><![CDATA[$F{fechaInicioActividadPlanTrabajo}]]></expression>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
            </element>

            <element kind="textField"
                uuid="f6040001-0206-4000-8000-000000000001"
                x="850" y="0"
                width="120" height="42"
                fontName="Arial" fontSize="7"
                hTextAlign="Center"
                vTextAlign="Middle"
                textAdjust="ScaleFont">
                <expression><![CDATA[$F{fechaFinActividadPlanTrabajo}]]></expression>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
            </element>

            <element kind="textField"
                uuid="f6040001-0207-4000-8000-000000000001"
                x="970" y="0"
                width="120" height="42"
                fontName="Arial" fontSize="8"
                hTextAlign="Center"
                vTextAlign="Middle"
                textAdjust="ScaleFont">
                <expression><![CDATA[$F{estadoProducto}]]></expression>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
            </element>

            <element kind="textField"
                uuid="f6040001-0208-4000-8000-000000000001"
                x="1090" y="0"
                width="190" height="42"
                fontName="Arial" fontSize="8"
                vTextAlign="Middle"
                textAdjust="ScaleFont">
                <expression><![CDATA[$F{tipologiaProducto}]]></expression>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
            </element>

            <element kind="textField"
                uuid="f6040001-0209-4000-8000-000000000001"
                x="1280" y="0"
                width="200" height="42"
                fontName="Arial" fontSize="8"
                vTextAlign="Middle"
                textAdjust="ScaleFont">
                <expression><![CDATA[$F{categoriaProducto}]]></expression>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
            </element>

            <element kind="textField"
                uuid="f6040001-0210-4000-8000-000000000001"
                x="1480" y="0"
                width="180" height="42"
                fontName="Arial" fontSize="8"
                vTextAlign="Middle"
                textAdjust="ScaleFont">
                <expression><![CDATA[$F{nombreResponsableProducto}]]></expression>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
            </element>

            <element kind="textField"
                uuid="f6040001-0211-4000-8000-000000000001"
                x="1660" y="0"
                width="260" height="42"
                fontName="Arial" fontSize="8"
                vTextAlign="Middle"
                textAdjust="ScaleFont">
                <expression><![CDATA[$F{nombreGrupoResponsableProducto}]]></expression>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
            </element>

        </band>

