                uuid="d4040001-0001-4000-8000-000000000002"
                x="95"
                y="2"
                width="70"
                height="56">

                <expression class="java.io.InputStream"><![CDATA[
                    Thread.currentThread()
                        .getContextClassLoader()
                        .getResourceAsStream(
